# Copy to .env.vercel.local (gitignored) — one-time setup for account / project switch.
# Token: https://vercel.com/account/tokens → Create Token
VERCEL_TOKEN=
# Team slug from dashboard URL or `npx vercel teams ls` (e.g. my-teams-projects-abc123)
VERCEL_SCOPE=
# Vercel project name (e.g. mginfo)
VERCEL_PROJECT=
# GitHub repo for push deploy (owner/name on chochoonwon-cupang account)
GITHUB_REPO=chochoonwon-cupang/mginfo
