{
  "name": "infocs-magazine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "facts:build": "node scripts/build-public-facts.mjs",
    "test:guards": "npx --yes tsx scripts/verify-publish-guards.ts && npx --yes tsx scripts/verify-region-uniqueness.ts && npx --yes tsx scripts/verify-youtube-priority.ts && npx --yes tsx scripts/verify-list-page.ts && npx --yes tsx scripts/verify-hub-board.ts",
    "vercel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action status",
    "vercel:teams": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action teams",
    "vercel:projects": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action projects",
    "vercel:link": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action link -UnlinkFirst",
    "vercel:git-connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action git-connect",
    "vercel:git-disconnect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action git-disconnect",
    "vercel:git-remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action git-remote",
    "vercel:git-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action git-status",
    "vercel:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-account.ps1 -Action deploy",
    "brand-studio:dist": "node scripts/rebuild-brand-studio.js",
    "brand-studio:sync-config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-brand-studio-config.ps1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.0.12",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.2"
  }
}
